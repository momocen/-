/* app.wxss - 全局样式 */
page {
  --primary: #1AAD19;
  --primary-dark: #129611;
  --danger: #E74C3C;
  --warning: #F39C12;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-muted: #999999;
  --border: #E5E5E5;
  --bg: #F5F5F5;
  --white: #FFFFFF;
  --radius: 12rpx;
  
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg);
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 20rpx 30rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: var(--white);
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}

/* 页面标题 */
.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

/* 主要按钮 */
.btn-primary {
  background: var(--primary);
  color: var(--white);
  border-radius: var(--radius);
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-primary:active {
  background: var(--primary-dark);
}

/* 次要按钮 */
.btn-secondary {
  background: var(--white);
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius);
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
}

/* 危险按钮 */
.btn-danger {
  background: var(--danger);
  color: var(--white);
  border-radius: var(--radius);
  font-size: 32rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

/* 表单区域 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: block;
}

.required::after {
  content: ' *';
  color: var(--danger);
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: var(--primary);
  background: var(--white);
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--bg);
  border-radius: var(--radius);
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-textarea:focus {
  border-color: var(--primary);
  background: var(--white);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
}

.tag-primary {
  background: #E8F5E9;
  color: var(--primary);
}

.tag-danger {
  background: #FDEDEC;
  color: var(--danger);
}

.tag-warning {
  background: #FEF5E7;
  color: var(--warning);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  color: #CCCCCC;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* Flex布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 图片网格 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
