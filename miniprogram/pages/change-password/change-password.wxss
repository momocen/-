/* pages/change-password/change-password.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

.container {
  padding: 30rpx;
}

.form-group {
  margin-bottom: 30rpx;
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 80rpx 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: #1AAD19;
  background: #FFF;
}

.toggle-pwd {
  position: absolute;
  right: 24rpx;
  top: 58rpx;
  font-size: 26rpx;
  color: #1AAD19;
}

.password-rules {
  padding: 16rpx;
  margin-bottom: 40rpx;
  font-size: 24rpx;
  color: #F39C12;
  background: #FEF5E7;
  border-radius: 8rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  color: #FFF;
  border-radius: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
}
