<!-- pages/change-password/change-password.wxml - 修改管理员密码 -->
<view class="page">
  <view class="container">
    <view class="form-card card">
      <view class="page-title">修改管理员密码</view>
      
      <view class="form-group">
        <view class="form-label required">当前密码</view>
        <input class="form-input" placeholder="请输入当前密码"
          value="{{oldPassword}}" bindinput="onOldPasswordInput"
          password="{{!showOld}}" maxlength="50"/>
        <view class="toggle-pwd" bindtap="toggleOld">
          {{showOld ? '隐藏' : '显示'}}
        </view>
      </view>

      <view class="form-group">
        <view class="form-label required">新密码</view>
        <input class="form-input" placeholder="请输入新密码（至少6位）"
          value="{{newPassword}}" bindinput="onNewPasswordInput"
          password="{{!showNew}}" maxlength="50"/>
        <view class="toggle-pwd" bindtap="toggleNew">
          {{showNew ? '隐藏' : '显示'}}
        </view>
      </view>

      <view class="form-group">
        <view class="form-label required">确认新密码</view>
        <input class="form-input" placeholder="请再次输入新密码"
          value="{{confirmPassword}}" bindinput="onConfirmPasswordInput"
          password="{{!showConfirm}}" maxlength="50"/>
        <view class="toggle-pwd" bindtap="toggleConfirm">
          {{showConfirm ? '隐藏' : '显示'}}
        </view>
      </view>

      <view class="password-rules">
        <text>密码要求：至少6位字符，建议包含字母和数字组合</text>
      </view>

      <button class="submit-btn" bindtap="handleSubmit" loading="{{loading}}">
        确认修改
      </button>
    </view>
  </view>
</view>
