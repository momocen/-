/* pages/report/report.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 80rpx;
}

.container {
  padding-bottom: 40rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  padding: 30rpx 30rpx 10rpx;
}

.page-desc {
  font-size: 24rpx;
  color: #999;
  padding: 0 30rpx 20rpx;
}

.form-card {
  margin: 0 20rpx 30rpx;
  padding: 30rpx;
}

.form-section {
  margin-bottom: 30rpx;
}

.location-btn {
  margin-top: 12rpx;
  padding: 16rpx;
  background: #F0F9F0;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #1AAD19;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #CCC;
  margin-top: 8rpx;
}

.acceptor-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.flex-2 {
  flex: 2;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  color: #333;
}

.date-picker.placeholder {
  color: #CCC;
}

.submit-section {
  padding: 0 20rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  color: #FFF;
  border-radius: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  opacity: 0.9;
}
