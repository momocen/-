/* pages/admin-dashboard/admin-dashboard.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

.toolbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #FFF;
  border-bottom: 1rpx solid #E5E5E5;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.toolbar-left {
  display: flex;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox.checked {
  background: #1AAD19;
  border-color: #1AAD19;
}

.checkbox.checked text {
  color: #FFF;
  font-size: 24rpx;
  font-weight: bold;
}

.selected-count {
  margin-left: 20rpx;
  font-size: 26rpx;
  color: #1AAD19;
}

.export-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  color: #FFF;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  height: auto;
  line-height: 1.5;
}

.export-btn[disabled] {
  background: #CCCCCC;
  color: #FFF;
}

.toolbar-right {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.delete-batch-btn {
  padding: 12rpx 24rpx;
  background: #FFF;
  color: #E74C3C;
  border: 2rpx solid #E74C3C;
  border-radius: 8rpx;
  font-size: 26rpx;
  height: auto;
  line-height: 1.5;
}

.delete-batch-btn[disabled] {
  background: #F5F5F5;
  color: #CCCCCC;
  border-color: #CCCCCC;
}

.stats-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 20rpx;
  padding: 20rpx 10rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1AAD19;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: #E5E5E5;
}

.report-list {
  padding-top: 10rpx;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}

.go-login-btn {
  margin-top: 30rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  color: #FFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}
