<!-- pages/admin-dashboard/admin-dashboard.wxml - 管理后台 -->
<view class="page">
  <!-- 非管理员提示 -->
  <view class="empty-state" wx:if="{{!isAdmin}}">
    <view class="empty-icon">🔒</view>
    <view class="empty-text">请使用管理员账号登录</view>
    <button class="go-login-btn" bindtap="goToLogin">管理员登录</button>
  </view>

  <!-- 管理员视图 -->
  <view wx:else>
    <!-- 顶部操作栏 -->
    <view class="toolbar">
      <view class="toolbar-left">
        <!-- 全选 -->
        <view class="select-all" bindtap="toggleSelectAll">
          <view class="checkbox {{allSelected ? 'checked' : ''}}">
            <text wx:if="{{allSelected}}">✓</text>
          </view>
          <text>全选</text>
        </view>
        <text class="selected-count" wx:if="{{selectedCount > 0}}">
          已选 {{selectedCount}} 条
        </text>
      </view>
      <view class="toolbar-right">
        <button 
          class="delete-batch-btn" 
          bindtap="handleBatchDelete"
          disabled="{{selectedCount === 0}}"
        >
          批量删除
        </button>
        <button 
          class="export-btn" 
          bindtap="handleExport" 
          disabled="{{selectedCount === 0}}"
          loading="{{exporting}}"
        >
          导出Excel
        </button>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="stats-bar card">
      <view class="stat-item">
        <text class="stat-num">{{totalCount}}</text>
        <text class="stat-label">总记录数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{todayCount}}</text>
        <text class="stat-label">今日新增</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{monthCount}}</text>
        <text class="stat-label">本月上报</text>
      </view>
    </view>

    <!-- 记录列表 -->
    <view class="report-list" wx:if="{{reports.length > 0}}">
      <report-card
        wx:for="{{reports}}"
        wx:key="_id"
        report="{{item}}"
        showActions="{{true}}"
        showCheckbox="{{true}}"
        bind:tap="onReportTap"
        bind:edit="onReportEdit"
        bind:delete="onReportDelete"
        bind:check="onReportCheck"
      />
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{reports.length === 0 && !loading}}">
      <view class="empty-icon">📋</view>
      <view class="empty-text">暂无隐患记录</view>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{hasMore && reports.length > 0}}">
      <text>{{loadingMore ? '加载中...' : '上拉加载更多'}}</text>
    </view>

    <view class="loading-more" wx:if="{{!hasMore && reports.length > 0}}">
      <text style="color: #CCC;">— 已加载全部记录 —</text>
    </view>
  </view>
</view>
