/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #E8F5E9 0%, #F5F5F5 100%);
}

.header {
  padding: 80rpx 0 60rpx;
  text-align: center;
}

.logo-container {
  margin-bottom: 30rpx;
}

.logo-placeholder {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin: 0 auto;
  box-shadow: 0 8rpx 30rpx rgba(26, 173, 25, 0.3);
}

.logo {
  width: 160rpx;
  height: 160rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #666;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.login-section {
  padding: 0 60rpx;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 12rpx;
  border: none;
}

.login-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.wx-login-btn {
  background: linear-gradient(135deg, #07C160, #1AAD19);
  color: #FFF;
}

.admin-login-btn {
  background: #FFF;
  color: #333;
  border: 2rpx solid #E5E5E5;
}

.login-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-bottom: 30rpx;
}

.or-divider {
  display: flex;
  align-items: center;
  margin: 30rpx 0;
}

.or-divider .line {
  flex: 1;
  height: 1rpx;
  background: #E5E5E5;
}

.or-text {
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 已登录状态 */
.logged-in-section {
  padding: 0 30rpx;
}

.welcome-card {
  text-align: center;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.welcome-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.user-type-tag {
  display: inline-block;
}

.feature-list {
  margin-bottom: 40rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.feature-card:active {
  background: #F5F5F5;
  transform: scale(0.98);
}

.feature-icon {
  font-size: 50rpx;
  margin-right: 20rpx;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
}

.feature-arrow {
  font-size: 40rpx;
  color: #CCC;
}

.logout-section {
  padding: 30rpx;
  text-align: center;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #FFF;
  color: #E74C3C;
  border: 2rpx solid #E74C3C;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
