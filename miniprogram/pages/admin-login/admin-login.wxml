<!-- pages/admin-login/admin-login.wxml - 管理员登录 -->
<view class="page">
  <view class="login-container">
    <!-- 标题 -->
    <view class="login-header">
      <view class="admin-icon">🔐</view>
      <view class="login-title">管理员登录</view>
      <view class="login-subtitle">请输入管理员账号和密码</view>
    </view>

    <!-- 登录表单 -->
    <view class="login-form card">
      <view class="form-group">
        <view class="form-label required">账号</view>
        <input 
          class="form-input" 
          placeholder="请输入管理员账号"
          value="{{username}}"
          bindinput="onUsernameInput"
          maxlength="50"
        />
      </view>

      <view class="form-group">
        <view class="form-label required">密码</view>
        <input 
          class="form-input" 
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
          password="{{showPassword ? false : true}}"
          maxlength="50"
        />
        <view class="password-toggle" bindtap="togglePassword">
          <text>{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>

      <button class="login-submit-btn" bindtap="handleLogin" loading="{{loading}}">
        登 录
      </button>
    </view>

    <!-- 提示信息 -->
    <view class="login-tips">
      <text class="tip-text">⚡ 提示：首次登录请使用初始账号密码，登录后可在个人中心修改密码</text>
    </view>

    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="goBack">
      <text>← 返回首页</text>
    </view>
  </view>
</view>
