/* pages/admin-login/admin-login.wxss */
.page {
  min-height: 100vh;
  background: linear-gradient(135deg, #E8F5E9 0%, #F5F5F5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-container {
  width: 100%;
  padding: 0 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.admin-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.login-subtitle {
  font-size: 26rpx;
  color: #999;
}

.login-form {
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 30rpx;
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: #1AAD19;
  background: #FFF;
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  top: 50%;
  font-size: 26rpx;
  color: #1AAD19;
}

.login-submit-btn {
  width: 100%;
  height: 90rpx;
  background: linear-gradient(135deg, #1AAD19, #07C160);
  color: #FFF;
  border-radius: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  margin-top: 40rpx;
}

.login-tips {
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #F39C12;
  line-height: 1.8;
}

.back-btn {
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
}
